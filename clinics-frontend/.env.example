# ══════════════════════════════════════════════════════════
#  Clinics Frontend — Environment Variables
#  Copy this file to .env.local and fill in the values.
#  .env.local is gitignored — never commit it.
# ══════════════════════════════════════════════════════════

# Backend URL — use /api for local dev (Vite proxy to localhost:9003)
VITE_API_URL=/api

# Labs service URL (radiology + health-checkups). Local dev uses /labs-api
# (Vite proxy to localhost:8086 — see vite.config.js). Production should be
# set to https://api-labs.zenohosp.com.
VITE_LABS_API_URL=/labs-api

# Labs *frontend* origin — used to build absolute "Open report" links into
# the labs UI (/lab/reports/{id}, /radiology/reports/{id}). Distinct from
# VITE_LABS_API_URL (this is the browser-facing host, not the API). Local
# dev defaults to the labs Vite dev port. Production: https://labs.zenohosp.com.
VITE_LABS_FRONTEND_URL=http://localhost:5175

# Send a multi-test order as ONE atomic requisition via labs' batch endpoint
# (POST /api/investigations/batch, labs Phase 10 / V17). Leave false until that
# endpoint is deployed; when off, the picker falls back to one create per test.
# Each test bills individually in both modes.
VITE_LABS_BATCH_ORDERS=false

# ── Dev mock auth (bypasses SSO for local development) ────────────────────
# Get the actual values from the project lead — do NOT leave these empty.
VITE_DEV_MOCK_AUTH=true
VITE_MOCK_USER_ID=
VITE_MOCK_USER_EMAIL=
VITE_MOCK_USER_ROLE=hospital_admin
VITE_MOCK_HOSPITAL_ID=
VITE_MOCK_JWT=
