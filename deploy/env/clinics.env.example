# ─────────────────────────────────────────────────────────────────────────────
#  /opt/zenohosp/env/clinics.env
#
#  Copy to the VPS, fill in the masked values, chmod 600. Never commit the
#  filled-in version — only this template belongs in git.
#
#  DB_*, JWT_SECRET and GOOGLE_* are shared verbatim with HMS: clinics uses the
#  same Supabase database and the same Directory-issued token signing secret.
#  Copy them out of /opt/zenohosp/env/hms.env rather than retyping.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared database (identical to hms.env) ───────────────────────────────────
# Clinics runs spring.jpa.hibernate.ddl-auto=none and only ever moves rows;
# HMS owns the schema.
DB_URL="jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0"
DB_USER=postgres.<project-ref>
DB_PASS=<same as hms.env>

# ── JWT ──────────────────────────────────────────────────────────────────────
# MUST be byte-identical to what Directory signs with. A mismatch produces a
# "logs in, then bounces straight back to /login" loop: the cookie gets set,
# but every /api/auth/me fails signature validation and 401s.
JWT_SECRET=<same as hms.env>

# ── Directory SSO client ─────────────────────────────────────────────────────
# OAUTH_REDIRECT_URI must byte-for-byte match OAUTH_CLINICS_REDIRECT_URI in
# directory.env, or the token exchange fails with an opaque invalid_grant.
DIRECTORY_CLIENT_ID=clinics-client
DIRECTORY_CLIENT_SECRET=<generate: openssl rand -base64 36>
OAUTH_REDIRECT_URI=https://api-clinics.zenohosp.com/login/oauth2/code/directory
DIRECTORY_API_URL=https://api-directory.zenohosp.com
DIRECTORY_AUTH_URI=https://api-directory.zenohosp.com/oauth2/authorize
DIRECTORY_TOKEN_URI=https://api-directory.zenohosp.com/oauth2/token
DIRECTORY_USER_INFO_URI=https://api-directory.zenohosp.com/api/users/me

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://clinics.zenohosp.com

# ── Shared SSO cookie across *.zenohosp.com ──────────────────────────────────
SSO_COOKIE_NAME=sso_token
SSO_COOKIE_DOMAIN=zenohosp.com
SSO_COOKIE_SECURE=true
SSO_COOKIE_MAX_AGE=86400

# ── Sibling services ─────────────────────────────────────────────────────────
LABS_API_URL=https://api-labs.zenohosp.com
ASSETS_API_URL=https://api-asset.zenohosp.com

# ── Google OAuth2 (legacy direct-login path inherited from HMS) ──────────────
GOOGLE_CLIENT_ID=<same as hms.env>
GOOGLE_CLIENT_SECRET=<same as hms.env>
